{
  "manifest_version": 3,
  "name": "YouTube Hidden Shorts",
  "version": "1.1.0",
  "description": "Hide YouTube Shorts from feed, search, sidebar, and channel pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["hide-shorts.css"],
      "run_at": "document_start"
    }
  ]
}
